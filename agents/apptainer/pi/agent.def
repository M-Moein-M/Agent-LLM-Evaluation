Bootstrap: docker
From: nvidia/cuda:12.4.1-devel-ubuntu22.04

# Apptainer image for the pi agent: CUDA devel base + Node 22 + pi built from
# upstream source with two small patches.
#
# Build (needs network; fakeroot):
#   APPTAINER_CACHEDIR=$TMPDIR/apptainer-cache \
#   apptainer build --fakeroot agents/apptainer/pi/agent.sif agents/apptainer/pi/agent.def
# %files paths are relative to the build CWD, so build from the repo root.
#
# PI VERSION: the measured results ran upstream earendil-works/pi at commit
# fd6659dd5d32d67feaa7ce2ba5eeb87c5705149c (main, ~100 commits after the v0.80.2 tag,
# package version still 0.80.2) plus the two patches in agents/apptainer/pi/patches/:
#   0001-step-limit.patch           adds `--step-limit <n>` (caps assistant turns)
#   0002-bash-default-timeout.patch bash tool defaults to a 600 s timeout
# Do not move to a newer pi without re-checking the trace parsers (checks/trace_stats.py)
# and the models.json schema. Override the commit with --build-arg PI_COMMIT=<sha>.

%arguments
    PI_COMMIT=fd6659dd5d32d67feaa7ce2ba5eeb87c5705149c

%files
    agents/apptainer/pi/patches /opt/pi-patches

%post
    echo "############################################################"
    echo "#                                                          #"
    echo "#   THIS BUILD NEEDS INTERNET ACCESS.                      #"
    echo "#   apt-get, npm install/ci, and pi-ai's model-list fetch  #"
    echo "#   all reach out during %post. Run from a node with       #"
    echo "#   outbound network, or this build will fail partway.     #"
    echo "#                                                          #"
    echo "############################################################"

    apt-get update -y && apt-get install -y --no-install-recommends \
        git \
        curl \
        wget \
        tree \
        ca-certificates \
        build-essential \
        libssl-dev \
        libffi-dev \
        libnuma-dev \
        rsync \
        jq \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    # Node.js 22.x: pi bundles undici@8.5.0, which needs Node >= 22. Node 20 crashes on launch.
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
    apt-get update -y && apt-get install -y --no-install-recommends nodejs \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    # Fetch upstream pi at the pinned commit, apply our patches, build the four
    # workspace packages, then install the packed tarballs in a single `npm install -g`
    # so the cross-package deps (@earendil-works/pi-*) resolve to these local builds.
    # The binary is named `pi`.
    mkdir -p /opt/pi-src && cd /opt/pi-src
    git init -q . && git remote add origin https://github.com/earendil-works/pi
    git fetch -q --depth 1 origin "{{ PI_COMMIT }}" && git checkout -q FETCH_HEAD
    for f in /opt/pi-patches/*.patch; do git apply "$f"; done
    npm ci --ignore-scripts
    # pi-ai's own `build` first downloads the live provider model catalogs, which moves
    # with the internet and no longer type-checks against this pinned source. Compile with
    # the catalogs committed at the pinned commit instead (our endpoints define their own
    # models in models.json, so the built-in catalog is not used).
    (cd packages/ai && npx tsgo -p tsconfig.build.json)
    for p in tui agent coding-agent; do
        npm run build --workspace="$(node -p "require('./packages/$p/package.json').name")"
    done
    mkdir -p /opt/pi-dist
    for p in ai tui agent coding-agent; do
        (cd packages/$p && npm pack --pack-destination /opt/pi-dist)
    done
    npm install -g /opt/pi-dist/earendil-works-pi-*.tgz
    cd /
    rm -rf /opt/pi-src /opt/pi-dist /opt/pi-patches

    # Nsight Systems CLI (nsys) for trustworthy external kernel timing in the
    # perf-grading path. The CUDA base repo does NOT carry the standalone CLI, so
    # add NVIDIA's devtools repo (which does). ISOLATED + non-fatal on purpose: a
    # hiccup here must not poison the Node/npm install above, and the image still
    # builds if the download is unavailable (check falls back to cudaEvent timing).
    ( apt-get update -y \
      && apt-get install -y --no-install-recommends gnupg wget ca-certificates \
      && ARCH="$(dpkg --print-architecture)" \
      && wget -qO- "https://developer.download.nvidia.com/devtools/repos/ubuntu2204/${ARCH}/nvidia.pub" \
         | gpg --dearmor -o /usr/share/keyrings/nvidia-devtools.gpg \
      && echo "deb [signed-by=/usr/share/keyrings/nvidia-devtools.gpg] https://developer.download.nvidia.com/devtools/repos/ubuntu2204/${ARCH}/ /" \
         > /etc/apt/sources.list.d/nvidia-devtools.list \
      && apt-get update -y \
      && apt-get install -y --no-install-recommends nsight-systems-cli ) \
        || echo "WARNING: nsight-systems-cli not installed — perf grading will fall back to cudaEvent timing"
    apt-get clean && rm -rf /var/lib/apt/lists/*

    # Config dir for the --home/bind target (pi reads ~/.pi/agent/models.json).
    mkdir -p /root/.pi/agent

%environment
    export PATH=/usr/local/bin:$PATH
