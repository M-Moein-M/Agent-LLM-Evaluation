Bootstrap: docker
From: nvidia/cuda:12.4.1-devel-ubuntu22.04

# Apptainer image for the pi agent. Mirrors agents/docker/pi/Dockerfile (CUDA
# devel base + Node 20 + pi-coding-agent) so the cluster runs the exact same
# toolchain as local Docker. The previous def bootstrapped node:20-slim, which
# had NO CUDA toolkit and could not compile/run the GPU problems.
#
# Build (on a node with fakeroot — you have it):
#   APPTAINER_CACHEDIR=$TMPDIR/apptainer-cache \
#   apptainer build --fakeroot agents/apptainer/pi/agent.sif agents/apptainer/pi/agent.def

%post
    apt-get update -y && apt-get install -y --no-install-recommends \
        git \
        curl \
        wget \
        tree \
        ca-certificates \
        build-essential \
        libssl-dev \
        libffi-dev \
        libnuma-dev \
        rsync \
        jq \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    # Node.js 20.x
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt-get update -y && apt-get install -y --no-install-recommends nodejs \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    npm install -g @mariozechner/pi-coding-agent

    # Nsight Systems CLI (nsys) for trustworthy external kernel timing in the
    # perf-grading path. The CUDA base repo does NOT carry the standalone CLI, so
    # add NVIDIA's devtools repo (which does). ISOLATED + non-fatal on purpose: a
    # hiccup here must not poison the Node/npm install above, and the image still
    # builds if the download is unavailable (check falls back to cudaEvent timing).
    ( apt-get update -y \
      && apt-get install -y --no-install-recommends gnupg wget ca-certificates \
      && ARCH="$(dpkg --print-architecture)" \
      && wget -qO- "https://developer.download.nvidia.com/devtools/repos/ubuntu2204/${ARCH}/nvidia.pub" \
         | gpg --dearmor -o /usr/share/keyrings/nvidia-devtools.gpg \
      && echo "deb [signed-by=/usr/share/keyrings/nvidia-devtools.gpg] https://developer.download.nvidia.com/devtools/repos/ubuntu2204/${ARCH}/ /" \
         > /etc/apt/sources.list.d/nvidia-devtools.list \
      && apt-get update -y \
      && apt-get install -y --no-install-recommends nsight-systems-cli ) \
        || echo "WARNING: nsight-systems-cli not installed — perf grading will fall back to cudaEvent timing"
    apt-get clean && rm -rf /var/lib/apt/lists/*

    # Config dir for the --home/bind target (pi reads ~/.pi/agent/models.json).
    mkdir -p /root/.pi/agent

%environment
    export PATH=/usr/local/bin:$PATH
