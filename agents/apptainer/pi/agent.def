Bootstrap: docker
From: nvidia/cuda:12.4.1-devel-ubuntu22.04

# Apptainer image for the pi agent. Mirrors agents/docker/pi/Dockerfile (CUDA
# devel base + Node 22 + pi-coding-agent) so the cluster runs the exact same
# toolchain as local Docker. The previous def bootstrapped node:20-slim, which
# had NO CUDA toolkit and could not compile/run the GPU problems.
#
# Build (on a node with fakeroot — you have it):
#   APPTAINER_CACHEDIR=$TMPDIR/apptainer-cache \
#   apptainer build --fakeroot agents/apptainer/pi/agent.sif agents/apptainer/pi/agent.def
#
# NOTE: this image installs a LOCAL FORK of pi (adds the `--step-limit` CLI flag),
# NOT the public @mariozechner/pi-coding-agent package. The fork is built from
# source INSIDE this container (%post below runs the pack/install steps from
# pi-edited/README.md's FORK NOTE) — the cluster's build/login nodes have no
# npm, so no prebuilt pi-dist/*.tgz are needed or checked in anymore. The
# build step needs network access (npm registry + pi-ai's model-list fetch).
# %files paths are relative to the build CWD, so build from the repo root.

%files
    agents/apptainer/pi/pi-edited/package.json /opt/pi-src/package.json
    agents/apptainer/pi/pi-edited/package-lock.json /opt/pi-src/package-lock.json
    agents/apptainer/pi/pi-edited/.npmrc /opt/pi-src/.npmrc
    agents/apptainer/pi/pi-edited/tsconfig.json /opt/pi-src/tsconfig.json
    agents/apptainer/pi/pi-edited/tsconfig.base.json /opt/pi-src/tsconfig.base.json
    agents/apptainer/pi/pi-edited/biome.json /opt/pi-src/biome.json
    agents/apptainer/pi/pi-edited/packages /opt/pi-src/packages

%post
    echo "############################################################"
    echo "#                                                          #"
    echo "#   THIS BUILD NEEDS INTERNET ACCESS.                      #"
    echo "#   apt-get, npm install/ci, and pi-ai's model-list fetch  #"
    echo "#   all reach out during %post. Run from a node with       #"
    echo "#   outbound network, or this build will fail partway.     #"
    echo "#                                                          #"
    echo "############################################################"

    apt-get update -y && apt-get install -y --no-install-recommends \
        git \
        curl \
        wget \
        tree \
        ca-certificates \
        build-essential \
        libssl-dev \
        libffi-dev \
        libnuma-dev \
        rsync \
        jq \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    # Node.js 22.x — the pi fork bundles undici@8.5.0, which needs Node >= 22
    # (uses webidl.util.markAsUncloneable). Node 20 makes pi crash on launch.
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
    apt-get update -y && apt-get install -y --no-install-recommends nodejs \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    # Build the local pi fork from source (FORK NOTE steps from
    # pi-edited/README.md), then install all four packed tarballs in a single
    # `npm install` so the cross-package deps (@earendil-works/pi-*) resolve to
    # these local builds instead of the public registry. The binary is still
    # named `pi`, so host.sh/solve.sh need no change.
    cd /opt/pi-src
    npm ci --ignore-scripts
    for p in ai tui agent coding-agent; do
        npm run build --workspace="$(node -p "require('./packages/$p/package.json').name")"
    done
    mkdir -p /opt/pi-dist
    for p in ai tui agent coding-agent; do
        (cd packages/$p && npm pack --pack-destination /opt/pi-dist)
    done
    npm install -g /opt/pi-dist/earendil-works-pi-*.tgz
    cd /
    rm -rf /opt/pi-src /opt/pi-dist

    # Nsight Systems CLI (nsys) for trustworthy external kernel timing in the
    # perf-grading path. The CUDA base repo does NOT carry the standalone CLI, so
    # add NVIDIA's devtools repo (which does). ISOLATED + non-fatal on purpose: a
    # hiccup here must not poison the Node/npm install above, and the image still
    # builds if the download is unavailable (check falls back to cudaEvent timing).
    ( apt-get update -y \
      && apt-get install -y --no-install-recommends gnupg wget ca-certificates \
      && ARCH="$(dpkg --print-architecture)" \
      && wget -qO- "https://developer.download.nvidia.com/devtools/repos/ubuntu2204/${ARCH}/nvidia.pub" \
         | gpg --dearmor -o /usr/share/keyrings/nvidia-devtools.gpg \
      && echo "deb [signed-by=/usr/share/keyrings/nvidia-devtools.gpg] https://developer.download.nvidia.com/devtools/repos/ubuntu2204/${ARCH}/ /" \
         > /etc/apt/sources.list.d/nvidia-devtools.list \
      && apt-get update -y \
      && apt-get install -y --no-install-recommends nsight-systems-cli ) \
        || echo "WARNING: nsight-systems-cli not installed — perf grading will fall back to cudaEvent timing"
    apt-get clean && rm -rf /var/lib/apt/lists/*

    # Config dir for the --home/bind target (pi reads ~/.pi/agent/models.json).
    mkdir -p /root/.pi/agent

%environment
    export PATH=/usr/local/bin:$PATH
