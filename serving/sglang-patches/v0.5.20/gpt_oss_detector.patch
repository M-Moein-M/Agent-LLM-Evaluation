+    def _call_from_json_body(
+        self, content: str, tool_indices: dict, tool_index: int
+    ) -> Optional[ToolCallItem]:
+        """
+        LOCAL PATCH: a message ending in <|call|> with no to=functions.X recipient whose
+        body is {"name": "get_weather", "arguments": {...}} (3 of 16,000 sampled
+        first-turn replies). Accepted only if name is a tool of the request.
+        """
+        body = content.split("<|message|>", 1)[-1].split("<|call|>", 1)[0]
+        try:
+            call = json.loads(body)
+        except json.JSONDecodeError:
+            return None
+        if not isinstance(call, dict) or not isinstance(call.get("name"), str):
+            return None
+        name = call["name"].removeprefix("functions.")
+        arguments = call.get("arguments", call.get("parameters"))
+        if name not in tool_indices or not isinstance(arguments, dict):
+            return None
+        return ToolCallItem(
+            tool_index=tool_index,
+            name=name,
+            parameters=json.dumps(arguments, ensure_ascii=False),
+        )
+
+    # LOCAL PATCH (sglang 0.5.20): the grammar constraint sglang builds for harmony
+    # ends generation right after the analysis message, so tool_choice "required"/named
+    # and tools with strict=true came back as an empty reply with no tool call. These
+    # three overrides skip the constraint and parse the model's own harmony tool call,
+    # as tool_choice "auto" already does. Cost: the forced call is not grammar-enforced.
+    #
+    # LOCAL PATCH, "unparsed call": a message ending in <|call|> that cannot become a
+    # tool call (no to=functions.X recipient, a function that is not in the request's
+    # tools, or arguments that are not valid JSON) was dropped, so the client got an
+    # empty reply. The three marked places above return the message body as normal
+    # content instead. Seen locally: 2 of 24,000 sampled tool-chain replies had no
+    # recipient (the model repeated the tool result as a "call").
+    def supports_structural_tag(self) -> bool:
+        return False
+
+    def parses_required_natively(self) -> bool:
+        return True
+
+    def get_structural_tag(self, *args, **kwargs):
+        return None
+
