# Serving configuration. Copy to serving/env and edit, or export the variables
# in your shell. Precedence: shell environment > serving/env > this file.
# Every assignment uses ${VAR:-default} so a value that is already set wins.
# Paths must be visible on every compute node (shared filesystem).

# --- directories ---------------------------------------------------------
# Workspace root: logs, LiteLLM venv, per-job monitoring and config dirs.
SERVE_ROOT=${SERVE_ROOT:-$HOME/llm-serving}
# Parent of the model directories. A model is read from $MODEL_DIR/<model name>.
MODEL_DIR=${MODEL_DIR:-$SERVE_ROOT/models}
# Apptainer images (sglang_*.sif, dcgm-exporter-ubuntu.sif, prometheus.sif, grafana.sif).
IMAGE_DIR=${IMAGE_DIR:-$SERVE_ROOT/images}
# Node-local staging directory (single-node mode copies the model here, STAGE_MODEL=0 skips it).
STAGE_DIR=${STAGE_DIR:-/tmp/${USER}-sglang-stage}
STAGE_MODEL=${STAGE_MODEL:-1}
# Patched sglang files and the patched gpt-oss chat template (built by sglang-patches/apply_patches.sh).
PATCH_DIR=${PATCH_DIR:-$SERVE_ROOT/patches}
# Extra python packages bound onto PYTHONPATH for images with a broken openai dependency (missing 'distro').
# Create once with: apptainer exec $IMAGE_DIR/<image>.sif pip install --target $PYLIBS_DIR distro
# Keep it under SERVE_ROOT: apptainer bind-mounts the job working dir, which is SERVE_ROOT.
PYLIBS_DIR=${PYLIBS_DIR:-$SERVE_ROOT/pylibs}
# gpt-oss /v1/responses needs the o200k harmony vocab, compute nodes may have no route out.
# Pre-fetch it on a login node (see sglang-patches/gpt-oss/README.md).
HARMONY_CACHE=${HARMONY_CACHE:-$MODEL_DIR/harmony-tiktoken-cache}
# Slurm stdout/stderr of the serve job.
LOG_DIR=${LOG_DIR:-$SERVE_ROOT/serve-logs}
# Per-job runtime files: <RUN_DIR>/<jobid>/{grafana-data,prometheus-data,litellm,*.log}.
RUN_DIR=${RUN_DIR:-$SERVE_ROOT/runs}

# --- LiteLLM -------------------------------------------------------------
LITELLM_VENV=${LITELLM_VENV:-$SERVE_ROOT/.venv-litellm}
LITELLM_BIN=${LITELLM_BIN:-$LITELLM_VENV/bin/litellm}
# Optional. Set it to require "Authorization: Bearer <key>" on the proxy.
# LiteLLM 1.104.x refuses to start without a key unless
# LITELLM_DANGEROUSLY_PERMIT_WEAK_OR_UNSET_MASTER_KEY=true is set.
LITELLM_MASTER_KEY=${LITELLM_MASTER_KEY:-}
# 1 adds LiteLLM's "prometheus" callback and a scrape job for the proxy. Default off.
LITELLM_PROMETHEUS=${LITELLM_PROMETHEUS:-0}

# --- ports ---------------------------------------------------------------
LITELLM_PORT=${LITELLM_PORT:-30000}      # front door, the only port clients use
# Internal SGLang (or sglang_router) port that LiteLLM forwards to. Deliberately not
# called SGLANG_PORT: sglang reads that env var as the base of its own port allocation.
BACKEND_PORT=${BACKEND_PORT:-30060}
DIST_PORT=${DIST_PORT:-20000}            # multi-node: TCP rendezvous for the TP/PP group
# Default listen ports of the monitoring images, used for scrape targets and the tunnel hint.
DCGM_PORT=${DCGM_PORT:-9400}
PROM_PORT=${PROM_PORT:-9090}
GRAFANA_PORT=${GRAFANA_PORT:-3000}
ENABLE_MONITORING=${ENABLE_MONITORING:-1}
# Suffix appended to the node name in the printed ssh tunnel hint (for example .example.org).
SSH_HOST_SUFFIX=${SSH_HOST_SUFFIX:-}

# --- Slurm header (written into the generated sbatch file by launch.sh) --
SBATCH_PARTITION=${SBATCH_PARTITION:-gpu}
SBATCH_ACCOUNT=${SBATCH_ACCOUNT:-}        # empty = line omitted
SBATCH_NODELIST=${SBATCH_NODELIST:-}      # empty = line omitted, pin a node to reuse its staged model
GPUS_PER_NODE=${GPUS_PER_NODE:-4}         # --gpus-per-node, also the unit for multi-node sizing
SBATCH_GRES=${SBATCH_GRES:-}              # if set (for example gpu:h100:4) used instead of --gpus-per-node
CPUS_PER_TASK=${CPUS_PER_TASK:-}          # empty = model default (32, or 128 for HiCache models)
TIME_LIMIT=${TIME_LIMIT:-24:00:00}
TIME_MIN=${TIME_MIN:-}                    # optional --time-min, empty = omitted
SBATCH_EXTRA=${SBATCH_EXTRA:-}            # one more raw option, for example --constraint=a100
JOB_NAME=${JOB_NAME:-}                    # empty = sgl-serve / sgl-serve-mn

# --- single-node router fleet knobs (all optional, see single-node/models/*.sh) ---
# FLEET_WORKERS, SGLANG_WORKER_TP, SGLANG_WORKER_GPU, SGLANG_ROUTER_POLICY,
# SGLANG_EVICTION_SECS, SGLANG_CACHE_THRESHOLD, SGLANG_BALANCE_ABS, SGLANG_BALANCE_REL,
# WORKER_STARTUP_TIMEOUT: set them in the shell when needed, defaults live in common/lib.sh.
