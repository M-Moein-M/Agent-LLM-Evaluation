     def _increment_content_block_index(self):
         self.current_content_block_index += 1
 
+    def _trigger_chunk_has_unsent_delta(self, processed_chunk: Any) -> bool:
+        """
+        LOCAL PATCH 2026-10-09.
+
+        True if the chunk that opened a new content block carries data that the
+        content_block_start event does not. Upstream forwarded only tool
+        arguments, so the first text / thinking chunk of a block was lost for
+        backends that stream ``reasoning_content`` (start block is empty there).
+        """
+        if processed_chunk.get("type") != "content_block_delta":
+            return False
+        delta = processed_chunk.get("delta")
+        if not isinstance(delta, dict):
+            return False
+        delta_type = delta.get("type")
+        if delta_type == "input_json_delta":
+            return bool(delta.get("partial_json"))
+        start = self.current_content_block_start or {}
+        if delta_type == "text_delta":
+            return bool(delta.get("text")) and not start.get("text")
+        if delta_type == "thinking_delta":
+            # Providers that send thinking_blocks already put the text in the
+            # start block; forwarding it again would duplicate it.
+            return bool(delta.get("thinking")) and not start.get("thinking")
+        return False
+
+    def _is_whitespace_inside_tool_call(self, chunk: Any) -> bool:
+        """
+        LOCAL PATCH 2026-10-09.
+
+        True for a chunk that carries only whitespace text while a tool_use
+        block is open. sglang sends a "\n" content chunk between two tool
+        calls, sometimes before the last argument chunk of the first call.
+        Upstream closed the tool_use block for it, so the late argument chunk
+        opened a nameless tool_use block and the first call lost its closing
+        brace. The caller skips such a chunk.
+        """
+        if self.current_content_block_type != "tool_use":
+            return False
+        try:
+            choice = chunk.choices[0]
+            delta = choice.delta
+        except (AttributeError, IndexError, TypeError):
+            return False
+        if choice.finish_reason is not None or getattr(chunk, "usage", None):
+            return False
+        if (
+            getattr(delta, "tool_calls", None)
+            or getattr(delta, "reasoning_content", None)
+            or getattr(delta, "thinking_blocks", None)
+        ):
+            return False
+        content = getattr(delta, "content", None)
+        return isinstance(content, str) and content != "" and content.strip() == ""
+
